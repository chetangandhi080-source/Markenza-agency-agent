# Markenza AI — local + deploy environment variables
# Copy to .env for local dev (`supabase start` will read this). For deploy,
# these are pushed via `supabase secrets set` in scripts/deploy.ps1.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Hermes 3 (Nous Research public endpoint)
HERMES_BASE_URL=https://hermes-agent.nousresearch.com
HERMES_MODEL=hermes-3-llama-3.1-405b
# Optional. Nous public endpoint is currently keyless, but if you have a key, set it.
HERMES_API_KEY=

# Apify
APIFY_TOKEN=apify_api_xxx
APIFY_LINKEDIN_ACTOR=bebity/linkedin-profile-scraper

# Gmail SMTP (use an App Password, not your real Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Markenza <hi@markenza.ai>

# Shared secret used by cron and the orchestrator to authenticate function-to-function calls
CRON_SECRET=generate-a-32-char-random-string
